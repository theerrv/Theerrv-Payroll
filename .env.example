# ── Database ──────────────────────────────────────────────────────────────────
# Supabase session-pooler connection string
# Format: Host=aws-0-ap-southeast-2.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<password>;Pooling=true;Maximum Pool Size=10
ConnectionStrings__Payroll=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters
Jwt__Key=
Jwt__Issuer=PayrollSaaS
Jwt__Audience=PayrollSaaS

# ── ASP.NET Core ──────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
# Port used by Docker image (Render uses 8080, local dotnet run uses 5096)
ASPNETCORE_HTTP_PORTS=8080

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (optional — defaults to localhost ports)
# Cors__AllowedOrigins__0=https://payroll.theerrv.com
